{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci && npx vite build"
  },
  "deploy": {
    "startCommand": "npx --yes serve@14 dist -l tcp://0.0.0.0:$PORT",
    "healthcheckPath": "/src/main/index.html",
    "restartPolicyType": "ON_FAILURE"
  }
}
